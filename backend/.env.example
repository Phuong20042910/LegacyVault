# =============================================
#   LEGACYVAULT BACKEND — ENVIRONMENT VARIABLES
# =============================================
# Copy file này thành .env và điền giá trị thực

# ----- Server -----
PORT=5000
NODE_ENV=development

# ----- MongoDB Atlas -----
# Lấy connection string từ MongoDB Atlas Dashboard > Connect > Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/legacyvault?retryWrites=true&w=majority

# ----- JWT -----
# Tự đặt một chuỗi ngẫu nhiên dài ít nhất 64 ký tự
JWT_SECRET=your_super_secret_jwt_key_minimum_64_characters_long_change_this_now
JWT_EXPIRES_IN=7d

# ----- Email (Gmail SMTP) -----
# Tạo App Password tại: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=noreply@legacyvault.vn

# ----- FPT.AI eKYC -----
# Đăng ký tại: https://fpt.ai/ekyc
FPTAI_EKYC_API_KEY=your_fptai_api_key
FPTAI_EKYC_BASE_URL=https://api.fpt.ai/vision/idr/vnm

# ----- File Upload -----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# ----- Frontend URL (CORS) -----
FRONTEND_URL=http://localhost:8443

# ----- Dead Man's Switch Scheduler -----
# Cron expression quét vault hàng giờ
DMS_CRON_CHECK=0 * * * *
# Cron expression quét escalation mỗi 6 giờ
DMS_CRON_ESCALATE=0 */6 * * *
